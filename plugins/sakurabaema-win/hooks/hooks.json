{
  "description": "在 Claude Code 執行結束或停止時播放提示音",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"(New-Object System.Media.SoundPlayer (('${CLAUDE_PLUGIN_ROOT}/audios/notification.wav' -replace '^/([a-zA-Z])/', '\\$1:\\') -replace '/', '\\')).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"(New-Object System.Media.SoundPlayer (('${CLAUDE_PLUGIN_ROOT}/audios/notification.wav' -replace '^/([a-zA-Z])/', '\\$1:\\') -replace '/', '\\')).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"(New-Object System.Media.SoundPlayer (('${CLAUDE_PLUGIN_ROOT}/audios/stop.wav' -replace '^/([a-zA-Z])/', '\\$1:\\') -replace '/', '\\')).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

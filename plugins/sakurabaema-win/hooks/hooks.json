{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"[System.Media.SoundPlayer]::new((Resolve-Path -LiteralPath ('${CLAUDE_PLUGIN_ROOT}/audios/notification.wav' -replace '^/([a-zA-Z])/', '\\$1:/')).ProviderPath).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"[System.Media.SoundPlayer]::new((Resolve-Path -LiteralPath ('${CLAUDE_PLUGIN_ROOT}/audios/notification.wav' -replace '^/([a-zA-Z])/', '\\$1:/')).ProviderPath).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"[System.Media.SoundPlayer]::new((Resolve-Path -LiteralPath ('${CLAUDE_PLUGIN_ROOT}/audios/stop.wav' -replace '^/([a-zA-Z])/', '\\$1:/')).ProviderPath).PlaySync()\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

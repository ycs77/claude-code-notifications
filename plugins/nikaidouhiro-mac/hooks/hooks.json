{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay \"${CLAUDE_PLUGIN_ROOT}/audios/notification.wav\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay \"${CLAUDE_PLUGIN_ROOT}/audios/notification.wav\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay \"${CLAUDE_PLUGIN_ROOT}/audios/stop.wav\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
